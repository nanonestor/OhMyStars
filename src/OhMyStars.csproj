<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Path to the KSA install; override via KSAGameDir env var or a local, untracked .user.props file -->
  <PropertyGroup>
    <KSAGameDir Condition="'$(KSAGameDir)' == ''">$(ProgramFiles)\Ahwoo\Games\Kitten Space Agency</KSAGameDir>
  </PropertyGroup>

  <Import Project="OhMyStars.csproj.user.props" Condition="Exists('OhMyStars.csproj.user.props')" />


<PropertyGroup>
  <!-- <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration> -->
  <!-- Or unconditionally force it (though not generally recommended for other build targets): -->
  <Configuration>Release</Configuration>
</PropertyGroup>

  <PropertyGroup>
    <ModNamespace>OhMyStars</ModNamespace>
    <AssemblyName>OhMyStars</AssemblyName>
    <ModsFolder>$(USERPROFILE)\Documents\My Games\Kitten Space Agency\mods</ModsFolder>
    <BuildDir>bin\$(Configuration)\$(TargetFramework)\</BuildDir>
    <SendBuildToTestDir>$(ModsFolder)\$(ModNamespace)</SendBuildToTestDir>
  </PropertyGroup>


  <ItemGroup>
    <ModContent Include="..\licenses\**\*">
      <TargetPath>licenses\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <ModContent Include="..\skycultures\**\*">
      <TargetPath>skycultures\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <ModContent Include="..\lines_in_20.txt">
      <TargetPath>lines_in_20.txt</TargetPath>
    </ModContent>
    <ModContent Include="..\catalogs\oms_catalog.csv;..\catalogs\oms_catalog_readme.md;..\catalogs\attributions.md;..\catalogs\oms-notes.txt">
      <TargetPath>catalogs\%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <ModContent Include="..\catalogs\OpenNGC\**\*">
      <TargetPath>catalogs\OpenNGC\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <ModContent Include="..\catalogs\definitively-correct-systems.csv" Condition="'$(Configuration)' == 'Debug'">
      <TargetPath>catalogs\%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <ModContent Include="..\catalogs\orb6orbits.txt;..\catalogs\orb6format.txt;..\catalogs\orb6-source.json">
      <TargetPath>catalogs\%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <!-- Hubble tube part: meshes/textures generated by parts\hubble scripts,
         Assets.xml generated by tools\PartBundler, GameData hand-written -->
    <ModContent Include="..\parts\hubble\build\*.glb" Exclude="..\parts\hubble\build\*_Anim.glb">
      <TargetPath>Meshes\%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <ModContent Include="..\parts\hubble\build\*_Anim.glb">
      <TargetPath>Animations\%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <ModContent Include="..\parts\hubble\build\*.png">
      <TargetPath>Textures\%(Filename)%(Extension)</TargetPath>
    </ModContent>
    <ModContent Include="..\parts\hubble\build\HubbleTubeAssets.xml;..\parts\hubble\HubbleTubeGameData.xml">
      <TargetPath>parts\%(Filename)%(Extension)</TargetPath>
    </ModContent>
  </ItemGroup>

  <!-- Copies built mod files to the game's mods folder -->
  <Target Name="CopyCustomContent" AfterTargets="AfterBuild">
    <Delete Condition="'$(Configuration)' != 'Debug'" Files="$(BuildDir)catalogs\definitively-correct-systems.csv;$(SendBuildToTestDir)\catalogs\definitively-correct-systems.csv" />
    <Delete Files="$(BuildDir)catalogs\README.md;$(BuildDir)catalogs\build-manifest.json;$(SendBuildToTestDir)\catalogs\README.md;$(SendBuildToTestDir)\catalogs\build-manifest.json" />
    <!-- Legacy parallax-era output; its old .bin files were picked up as extra star binaries. -->
    <RemoveDir Directories="$(SendBuildToTestDir)\parallax" />
    <Delete Files="$(SendBuildToTestDir)\athyg_32_reduced_m10.toml;$(SendBuildToTestDir)\athyg_32_reduced_m10.csv;$(BuildDir)athyg_32_reduced_m10.csv" />
    <!-- Old names/locations of the default star binary (now binaries\OhMyStars_stars.bin + binaries\OhMyStars__stars_IDs.bin). -->
    <Delete Files="$(SendBuildToTestDir)\OhMyStars_curated.bin;$(SendBuildToTestDir)\OhMyStars_curated.ohmystars.bin;$(SendBuildToTestDir)\OhMyStars_curated.bin.version;$(SendBuildToTestDir)\OhMyStars_stars.bin;$(SendBuildToTestDir)\OhMyStars__stars_IDs.bin;$(SendBuildToTestDir)\OhMyStars_stars.bin.version" />
    <Copy SourceFiles="$(BuildDir)mod.toml" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="$(BuildDir)$(ModNamespace).deps.json" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="$(BuildDir)$(ModNamespace).dll" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="ModMenu.Attributes.dll" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\settings.ini" DestinationFolder="$(SendBuildToTestDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(BuildDir)NOTICE.txt" DestinationFolder="$(SendBuildToTestDir)" />
    <MakeDir Directories="$(BuildDir)licenses;$(BuildDir)skycultures;$(SendBuildToTestDir)\licenses;$(SendBuildToTestDir)\skycultures" />
    <Copy SourceFiles="@(ModContent)" DestinationFiles="@(ModContent->'$(BuildDir)\%(TargetPath)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModContent)" DestinationFiles="@(ModContent->'$(SendBuildToTestDir)\%(TargetPath)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <!-- nuget.org doesn't have this package; reference the local dll below instead -->
    <!-- <PackageReference Include="ModMenu.Attributes" Version="1.0.2" /> -->
    <PackageReference Include="StarMap.API" Version="0.3.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\packaging\mod.toml" Link="mod.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\NOTICE.txt" Link="NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\lines_in_20.txt" Link="lines_in_20.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="settings.ini">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Remove="athyg_32_reduced_m10.csv" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ModMenu.Attributes">
      <HintPath>ModMenu.Attributes.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Core">
      <HintPath>$(KSAGameDir)\Brutal.Core.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Strings">
      <HintPath>$(KSAGameDir)\Brutal.Strings.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Logging">
      <HintPath>$(KSAGameDir)\Brutal.Logging.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Numerics">
      <HintPath>$(KSAGameDir)\Brutal.Numerics.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>$(KSAGameDir)\Brutal.ImGui.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.ImGui.Abstractions">
      <HintPath>$(KSAGameDir)\Brutal.ImGui.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.ImGui.Extensions">
      <HintPath>$(KSAGameDir)\Brutal.ImGui.Extensions.dll</HintPath>
    </Reference>
    <Reference Include="BepuUtilities">
      <HintPath>$(KSAGameDir)\BepuUtilities.dll</HintPath>
    </Reference>
    <Reference Include="BepuPhysics">
      <HintPath>$(KSAGameDir)\BepuPhysics.dll</HintPath>
    </Reference>
    <Reference Include="Planet.Render.Core">
      <HintPath>$(KSAGameDir)\Planet.Render.Core.dll</HintPath>
    </Reference>
    <Reference Include="KSA">
      <HintPath>$(KSAGameDir)\KSA.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

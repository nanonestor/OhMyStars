<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Path to the KSA install; override via KSAGameDir env var or a local, untracked .user.props file -->
  <PropertyGroup>
    <KSAGameDir Condition="'$(KSAGameDir)' == ''">$(ProgramFiles)\Kitten Space Agency</KSAGameDir>
  </PropertyGroup>

  <Import Project="OhMyStars.csproj.user.props" Condition="Exists('OhMyStars.csproj.user.props')" />

  <PropertyGroup>
    <ModNamespace>OhMyStars</ModNamespace>
    <AssemblyName>OhMyStars</AssemblyName>
    <ModsFolder>$(USERPROFILE)\Documents\My Games\Kitten Space Agency\mods</ModsFolder>
    <BuildDir>bin\Debug\$(TargetFramework)\</BuildDir>
    <SendBuildToTestDir>$(ModsFolder)\$(ModNamespace)</SendBuildToTestDir>
  </PropertyGroup>

  <!-- Copies built mod files to the game's mods folder -->
  <Target Name="CopyCustomContent" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(BuildDir)mod.toml" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="$(BuildDir)$(ModNamespace).deps.json" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="$(BuildDir)$(ModNamespace).dll" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="ModMenu.Attributes.dll" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="$(BuildDir)settings.ini" DestinationFolder="$(SendBuildToTestDir)" Condition="Exists('$(BuildDir)settings.ini')" />
    <Copy SourceFiles="$(BuildDir)athyg_32_reduced_m10.csv" DestinationFolder="$(SendBuildToTestDir)" />
    <Copy SourceFiles="$(BuildDir)NOTICE.txt" DestinationFolder="$(SendBuildToTestDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <!-- nuget.org doesn't have this package; reference the local dll below instead -->
    <!-- <PackageReference Include="ModMenu.Attributes" Version="1.0.2" /> -->
    <PackageReference Include="StarMap.API" Version="0.3.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\packaging\mod.toml" Link="mod.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\NOTICE.txt" Link="NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="settings.ini">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="athyg_32_reduced_m10.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Original hardcoded HintPaths, kept for reversion:
  <ItemGroup>
    <Reference Include="Brutal.Core.Common">
      <HintPath>..\..\..\..\..\..\Program Files\Kitten Space Agency\Brutal.Core.Common.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Core.Logging">
      <HintPath>..\..\..\..\..\..\Program Files\Kitten Space Agency\Brutal.Core.Logging.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>..\..\..\..\..\..\Program Files\Kitten Space Agency\Brutal.Core.Numerics.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>..\..\..\..\..\..\Program Files\Kitten Space Agency\Brutal.ImGui.dll</HintPath>
    </Reference>
    <Reference Include="KSA">
      <HintPath>..\..\..\..\..\..\Program Files\Kitten Space Agency\KSA.dll</HintPath>
    </Reference>
  </ItemGroup>
  -->

  <ItemGroup>
    <Reference Include="ModMenu.Attributes">
      <HintPath>ModMenu.Attributes.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Core.Common">
      <HintPath>$(KSAGameDir)\Brutal.Core.Common.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Core.Logging">
      <HintPath>$(KSAGameDir)\Brutal.Core.Logging.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(KSAGameDir)\Brutal.Core.Numerics.dll</HintPath>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>$(KSAGameDir)\Brutal.ImGui.dll</HintPath>
    </Reference>
    <Reference Include="KSA">
      <HintPath>$(KSAGameDir)\KSA.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

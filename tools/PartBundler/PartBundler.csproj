<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Path to the KSA install; override via KSAGameDir env var -->
  <PropertyGroup>
    <KSAGameDir Condition="'$(KSAGameDir)' == ''">$(ProgramFiles)\Ahwoo\Games\Kitten Space Agency</KSAGameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KSA">
      <HintPath>$(KSAGameDir)\KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
